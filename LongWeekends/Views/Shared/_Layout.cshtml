<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LongWeekends</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/fontawesome_6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LongWeekends.styles.css" asp-append-version="true" />

    <style>
        
        .loading {
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            text-align: center;
            background: rgba( 255, 255, 255, .8 );
            z-index: 9999;
            display: none;
        }

        .loading_text {
            position: absolute;
            /* top: 50%; */
            left: 50%;
            bottom: 250px;
            transform: translate(-50%, -50%);
        }

        .loading-img {
            position: absolute;
            /* display: block; */
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            /* margin-left: auto;
                    margin-right: auto; */
            width: 50%;
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="loading">
        <img class="loading-img" src="~/LoadingAnimation.gif">
        <p class="loading_text">
            Loading
        </p>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">LongWeekends</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LongWeekends - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>

        $(document).ajaxStart(function () {
            $(".loading").show();
        });
        $(document).ajaxStop(function () {
            $(".loading").hide();
        });

        $(this).submit(function (e) {
            $(".loading").show();
        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
